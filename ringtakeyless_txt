-- Shake & Flash Red Error Animation
local isShaking = false
local function playErrorAnimation()
	if isShaking then return end
	isShaking = true

	local basePos = MainFrame.Position
	local defaultStrokeColor = Color3.fromRGB(100, 110, 245)
	local defaultStrokeTrans = 0.4
	local errorRedColor = Color3.fromRGB(255, 60, 60)

	-- Flash red stroke
	TweenService:Create(MainStroke, TweenInfo.new(0.1, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
		Color = errorRedColor,
		Thickness = 2.5,
		Transparency = 0.1
	}):Play()

	-- Smooth Shake Sequence
	local shakeOffsets = { 10, -8, 6, -4, 2, 0 }
	local tweenInfo = TweenInfo.new(0.06, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)

	task.spawn(function()
		for _, offset in ipairs(shakeOffsets) do
			local targetPos = basePos + UDim2.new(0, offset, 0, 0)
			local shakeTween = TweenService:Create(MainFrame, tweenInfo, {Position = targetPos})
			shakeTween:Play()
			shakeTween.Completed:Wait()
		end

		MainFrame.Position = basePos

		-- Restore default stroke
		TweenService:Create(MainStroke, TweenInfo.new(0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
			Color = defaultStrokeColor,
			Thickness = 1.2,
			Transparency = defaultStrokeTrans
		}):Play()

		isShaking = false
	end)
end

