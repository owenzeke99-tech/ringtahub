-- ==========================================
-- HỆ THỐNG KIỂM TRA & LƯU KEY (24 GIỜ)
-- ==========================================
local function saveKeyData(key)
	if writefile then
		local data = {
			Key = key,
			ExpireTimestamp = os.time() + (24 * 3600) -- Hết hạn sau 24 giờ (86400 giây)
		}
		writefile(SaveFileName, HttpService:JSONEncode(data))
	end
end

local function checkSavedKey()
	if readfile and isfile and isfile(SaveFileName) then
		local success, result = pcall(function()
			return HttpService:JSONDecode(readfile(SaveFileName))
		end)
		
		if success and result and result.Key and result.ExpireTimestamp then
			-- Kiểm tra xem key có đúng và còn thời hạn hay không
			if result.Key == CorrectKey and os.time() < result.ExpireTimestamp then
				return true
			end
		end
	end
	return false
end

-- Nếu đã lưu key và chưa hết hạn 24h, load script ngay lập tức!
if checkSavedKey() then
	loadMainScript()
	return
end

